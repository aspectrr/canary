# --- AI report generation (required) ---
# Without OPENROUTER_API_KEY, investigations will error (Canary never silently
# falls back to rules-only reports). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Primary model used to write the safety report.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Backup model tried automatically if the primary fails after retries.
# Keep it fast and broadly available so the cascade reliably rescues a flaky primary.
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash

# Stall-detection window in ms. The call aborts if no tokens arrive for this
# duration. Not a hard total cap — slow models that keep producing are fine.
OPENROUTER_TIMEOUT_MS=120000

# --- Web search enrichment (optional but recommended) ---
# Brave Search API key. When set, Canary searches the web for independent
# reputation signals about the project. Without it, this evidence source is
# skipped (the rest of the pipeline is unaffected). Get a key at
# https://api.search.brave.com/ (free tier: 2,000 queries/month).
BRAVE_SEARCH_API_KEY=

# --- GitHub API (optional, raises rate limit) ---
# Without a token, GitHub allows 60 API requests/hour per IP. With one, 5,000/hour.
# Recommended for any real deployment. Create a classic token at
# https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=
